# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
POSTGRES_USER=payerguard
POSTGRES_PASSWORD=payerguard
POSTGRES_DB=payerguard
DATABASE_URL=postgresql://payerguard:payerguard@localhost:5432/payerguard

# --- LLM (Mistral) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- CORS ---
# Browser origins allowed to call this API, as a JSON array (pydantic-settings
# parses list[str] as JSON). Vite dev server + eventual Docker frontend port.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Ingestion ---
# Folder watched for continuous/repeated batch ingestion (not a live stream).
INGESTION_WATCH_DIR=./data/raw
